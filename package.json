{
  "name": "pi-execsumo",
  "version": "0.1.0",
  "description": "Execsumo's personal Pi extensions",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions/calm.ts",
      "./extensions/commands.ts",
      "./extensions/minimal-footer.ts",
      "./node_modules/@estebanforge/pi-codegraph-enhanced/extensions/codegraph.ts",
      "./node_modules/@dietrichgebert/ponytail/pi-extension/index.js",
      "./node_modules/@tintinweb/pi-subagents/src/index.ts",
      "./node_modules/pi-blackhole/index.ts",
      "./node_modules/pi-mcp-adapter/index.ts"
    ],
    "skills": [
      "./node_modules/@dietrichgebert/ponytail/skills",
      "./node_modules/pi-mcp-adapter/skills"
    ],
    "themes": ["./themes"]
  },
  "dependencies": {
    "@estebanforge/pi-codegraph-enhanced": "1.0.6",
    "@dietrichgebert/ponytail": "4.10.0",
    "@tintinweb/pi-subagents": "0.19.0",
    "pi-blackhole": "0.5.5",
    "pi-mcp-adapter": "2.34.0"
  },
  "bundledDependencies": [
    "@estebanforge/pi-codegraph-enhanced",
    "@dietrichgebert/ponytail",
    "@tintinweb/pi-subagents",
    "pi-blackhole",
    "pi-mcp-adapter"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
